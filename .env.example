# Credenciales de la API de datos de Alpaca.
#
# Se usan SOLO en el servidor (src/app/api/alpaca/route.ts): nunca llegan al
# navegador. Para desarrollo, copiá este archivo como .env.local y completá
# los valores. Para producción, cargalas en Vercel → Settings →
# Environment Variables.
#
# Se generan en https://app.alpaca.markets → Home → API Keys.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
